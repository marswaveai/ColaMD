{
  "name": "colamd",
  "version": "2.7.9",
  "description": "A free, elegant Markdown editor for macOS, Windows and Linux. Simple by design, always in sync with the file on disk.",
  "main": "dist/main/index.js",
  "author": {
    "name": "marswave.ai",
    "email": "hello@marswave.ai"
  },
  "license": "MIT",
  "homepage": "https://github.com/marswaveai/colamd",
  "repository": {
    "type": "git",
    "url": "https://github.com/marswaveai/colamd.git"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "dist": "electron-vite build && electron-builder",
    "dist:mac": "electron-vite build && electron-builder --mac",
    "dist:win": "electron-vite build && electron-builder --win",
    "dist:linux": "electron-vite build && electron-builder --linux",
    "build:web": "vite build --config vite.web.config.ts",
    "preview:web": "vite preview --config vite.web.config.ts",
    "check:theme-colors": "node scripts/check-theme-colors.mjs",
    "verify:markdown": "node scripts/verify-markdown.mjs",
    "verify:links": "node scripts/verify-links.mjs",
    "verify:features": "node scripts/verify-features.mjs",
    "verify:tables": "node scripts/verify-tables.mjs",
    "verify:table-caret": "node scripts/verify-table-caret.mjs",
    "verify:table-syntax": "node scripts/verify-table-syntax.mjs",
    "verify:scroll-render": "node scripts/verify-scroll-render.mjs",
    "verify:source-mode": "node scripts/verify-source-mode.mjs",
    "verify:image-export": "node scripts/verify-image-export.mjs",
    "verify:export-pdf": "node scripts/verify-export-pdf.mjs",
    "verify:themes": "node scripts/verify-themes.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.7.2",
    "@lezer/markdown": "^1.7.2",
    "docx": "^9.7.1",
    "electron-updater": "^6.8.9",
    "katex": "^0.16.47",
    "pele": "^1.6.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@types/katex": "^0.16.8",
    "electron": "^44.3.0",
    "electron-builder": "^26.16.1",
    "electron-vite": "^3.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
